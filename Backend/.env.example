# Servidor
PORT=3001
APP_ENV=development
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:3001
CORS_ORIGIN=*

# Seguridad
JWT_SECRET=leons-dev-secret-cambiar-en-produccion
JWT_EXPIRES_IN=7d

# Integraciones (aún no conectadas)
GOOGLE_CLIENT_ID=

# Almacenamiento local de imágenes de seguimiento
UPLOAD_DIR=storage/uploads

# Límites
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_ALERTS_MAX=10

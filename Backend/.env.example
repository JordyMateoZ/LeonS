APP_ENV=development
API_PREFIX=/api/v1
JWT_SECRET=cambia-esto-en-produccion-minimo-32-bytes
ACCESS_TOKEN_MINUTES=1440

# CORS (Fase 4.4, S2): lista JSON de orígenes permitidos.
# En desarrollo bastan los dos locales. En producción (APP_ENV=production) es
# obligatorio declararla con los dominios reales: se rechazan '*', localhost
# y listas vacías, y no se hereda el valor de desarrollo.
# Ejemplo: CORS_ORIGINS=["https://leons.example.com","https://www.leons.example.com"]
CORS_ORIGINS=["http://localhost:4200","http://localhost:4000"]

REPOS_BACKEND=memory
UPLOADS_DIR=uploads
RATE_LIMIT_ALERTS_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60

# Rate limiting (Fase 4.1): los límites de /auth/login y /auth/registro son
# locales a cada proceso. Con varios workers o instancias, el límite efectivo
# se multiplica; para límites compartidos hace falta un almacén externo
# (Redis u otro) y un backend de rate limiting distribuido.

# SQL Server (Fases 5 y 6)
# Autenticación de Windows: usuario vacío + Trusted_Connection=yes.
# La instancia nombrada lleva la barra invertida literal: SQLAlchemy 2.1
# no decodifica %5C en el host (verificado el 18/11/2026).
# Desarrollo local: TrustServerCertificate=yes es aceptado solo si
# APP_ENV no es "production" (Fase 4.4, S3).
DB_URL=mssql+pyodbc://@localhost\SQLEXPRESS/LeonsDB?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&Encrypt=yes&TrustServerCertificate=yes
DB_TEST_URL=mssql+pyodbc://@localhost\SQLEXPRESS/LeonsDB_Test?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&Encrypt=yes&TrustServerCertificate=yes

# Producción (APP_ENV=production) — requisitos de Fase 4.4:
#   * DB_URL obligatoria y con Encrypt=yes.
#   * TrustServerCertificate NO debe aparecer (el certificado del servidor se
#     valida contra la cadena de confianza). Si el servidor no tiene un
#     certificado válido firmado por una CA de confianza, la infraestructura
#     debe proporcionarlo antes del despliegue.
#   * CORS_ORIGINS con los dominios reales del frontend.
#   * JWT_SECRET propio de al menos 32 caracteres, distinto del valor de desarrollo.

# Alternativa con login SQL (Q-02) — reemplaza las dos líneas anteriores:
# DB_URL=mssql+pyodbc://leons_app:ClaveSegura@localhost\SQLEXPRESS/LeonsDB?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
# DB_TEST_URL=mssql+pyodbc://leons_app:ClaveSegura@localhost\SQLEXPRESS/LeonsDB_Test?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
